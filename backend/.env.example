# ============================================
# CONFIGURACIÓN DE ENTORNO - BOX CROSSFIT
# ============================================
# IMPORTANTE: Copia este archivo como .env y completa los valores reales
# NO subas el archivo .env a GitHub (ya está en .gitignore)

# Base de datos PostgreSQL en Neon
# Formato: postgresql://usuario:password@host/database?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/nombredb?sslmode=require

# URL de PRODUCCIÓN (solo scripts de sincronización/auditoría: sync_test_from_prod, etc.)
# NUNCA hardcodear credenciales en el código: definirla aquí localmente.
DATABASE_URL_PROD=postgresql://usuario:password@ep-xxxxx.region.aws.neon.tech/nombredb?sslmode=require

# Seguridad JWT
# Genera una clave secreta segura con: openssl rand -hex 32
JWT_SECRET_KEY=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# SECRET_KEY para JWT (alternativa simplificada)
SECRET_KEY=urban_training_box_secret_key_2026_jwt

# Configuración de la aplicación
APP_NAME=Box CrossFit Platform
APP_VERSION=1.0.0
DEBUG=True  # Cambiar a False en producción

# CORS (dominios permitidos para el frontend)
# En desarrollo local: http://localhost:5173
# En producción: https://tudominio.com, https://*.tudominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL base del frontend (usada en los links/CTA de los correos).
# - Dev: http://localhost:5173 (o el puerto real del frontend en dev)
# - PRODUCCIÓN: ⚠️ el dominio REAL queda pendiente hasta el despliegue a VPS
#   (antes apuntaba hardcodeado a un dominio que no resolvía). Definir acá el
#   dominio real cuando exista; los correos lo leen de settings.FRONTEND_URL.
FRONTEND_URL=http://localhost:5173

# Configuración de archivos (futuro: S3 o almacenamiento local)
UPLOAD_DIR=./uploads/vouchers
MAX_UPLOAD_SIZE_MB=5

# ── Almacenamiento de los archivos subidos (app/services/storage.py) ──────────
# local = dev/TEST (disco: app/private_uploads y app/static/uploads)
# r2    = PROD (Cloudflare R2). El disco del contenedor es EFÍMERO: sin R2, cada
#         deploy borraba los comprobantes, certificados e imágenes.
STORAGE_BACKEND=local

# Bucket PROPIO de los archivos de la app (NO el de respaldos: no compartir bucket
# ni token con `box-crossfit-backups`). Vacío mientras STORAGE_BACKEND=local.
# Token de R2 con Object Read & Write LIMITADO a estos buckets.
STORAGE_R2_ENDPOINT=
STORAGE_R2_BUCKET=box-crossfit-uploads
# Bucket PÚBLICO (fotos del Bazar). Cloudflare expone el bucket COMPLETO (no un
# prefijo): el público va SEPARADO del privado para que un voucher nunca sea
# accesible sin token. En PROD es OBLIGATORIO que sean distintos.
STORAGE_R2_PUBLIC_BUCKET=box-crossfit-public
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
# URL pública del bucket público (acceso público habilitado en ESE bucket): su
# dominio r2.dev o el dominio propio. Ej: https://pub-xxxxxxxx.r2.dev
STORAGE_R2_PUBLIC_BASE_URL=

# API key de los endpoints de automatización (header `X-N8N-API-Key`):
# cron de Render `box-crossfit-kpis-ml` y POST /api/v1/kpis/populate/*,
# /api/v1/ml/reentrenar, /api/v1/segmentacion/reentrenar.
# El webhook POST /api/v1/asistencia/n8n/evaluar-mes se eliminó en 2026-10
# (el cierre de mes ahora lo dispara APScheduler).
# Generar con: openssl rand -hex 32
N8N_API_KEY=tu_clave_secreta_n8n_aqui

# Reactivación (correo "sin plan"): secret para firmar los tokens HMAC del
# opt-out (GET /api/v1/notificaciones/reactivacion/optout). Generar con:
# openssl rand -hex 32
REACTIVACION_OPT_OUT_SECRET=tu_clave_secreta_reactivacion_aqui

# URL base del BACKEND para links dentro de correos (p.ej. el opt-out de
# reactivación vive en el backend, no en el frontend).
# - Dev: http://localhost:8000
# - PRODUCCIÓN: la URL pública del API cuando exista el dominio/VPS.
BACKEND_PUBLIC_URL=http://localhost:8000
