# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.cron — imagen MÍNIMA para el Cron Job de Render.
#
# Sirve para UNA sola cosa: hacer el backup diario de la base REAL de PROD
# (pg_dump) y subirlo a Cloudflare R2. No toca el web service ni
# `Dockerfile.render` / `backend/Dockerfile` (esos siguen igual).
#
# Por qué una imagen aparte:
#   * El web service no necesita pg_dump ni boto3 (menos superficie).
#   * El código del backup corre aislado, sin acceso a la app ni a sus secretos.
#
# Contexto de build = backend/  (para que `COPY maintenance/` resuelva):
#   docker build -f backend/Dockerfile.cron backend -t box-crossfit-backup-cron:local
# ============================================================
FROM python:3.12-slim

# pg_dump de la MISMA major que el servidor de Neon (18.x).
# Debian 13 trae el cliente 17 y pg_dump ABORTA contra un servidor 18:
#   "pg_dump: error: aborting because of server version mismatch
#    detail: server version: 18.6; pg_dump version: 17.11"
# (es el bug que dejó el mecanismo de backups sin funcionar hasta el 26/09).
# Se instala el 18 desde el repo oficial PGDG y se VERIFICA en el build: si PGDG
# o la base cambian de major, el build falla en vez de fallar en silencio de noche.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && grep -q '^VERSION_CODENAME=trixie' /etc/os-release \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/* \
    && pg_dump --version \
    && pg_dump --version | grep -q " 18\." \
    && pip install --no-cache-dir boto3

# TZ=Chile para que los nombres de archivo salgan en hora local del box.
# DRY_RUN=1 por defecto: si alguien olvida la variable, la imagen NO sube nada.
ENV TZ=America/Santiago \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DRY_RUN=1

WORKDIR /app

# Solo el paquete maintenance + el script del backup (sin la app: nada que
# importe FastAPI/SQLAlchemy en un contenedor que solo hace pg_dump).
COPY maintenance/__init__.py ./maintenance/__init__.py
COPY maintenance/backup_cloud.py ./maintenance/backup_cloud.py

# Usuario no-root (OJO: en Debian ya existe un usuario de sistema `backup`
# con UID 34 ⇒ `useradd backup` falla con "username already in use").
RUN useradd --create-home --uid 1000 boxapp \
    && chown -R boxapp:boxapp /app
USER boxapp

# El Cron Job de Render ejecuta este CMD (en runtime Docker no hay campo
# "Command": usa ENTRYPOINT/CMD salvo que se defina un Docker Command).
CMD ["python", "-m", "maintenance.backup_cloud"]
