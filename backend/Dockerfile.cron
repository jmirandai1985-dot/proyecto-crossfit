# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.cron — imagen MÍNIMA para el Cron Job de Render.
#
# La usan los 4 Cron Jobs de mantenimiento, todos con `python -m maintenance.<script>`:
#   * `mantenimiento_cloud` → mantenimiento de datos de PROD los días 1 y 15 (rol `maint_rw`)
#   * `backup_cloud`        → backup diario de la base REAL de PROD (pg_dump) a Cloudflare R2
#   * `watchdog_backups`    → vigila la frescura de ese backup (solo lee R2) y avisa por mail
#   * `restore_drill`       → drill mensual de restore en una rama temporal de Neon
# No toca el web service ni `Dockerfile.render` / `backend/Dockerfile` (esos siguen igual).
#
# Por qué una imagen aparte:
#   * El web service no necesita pg_dump (menos superficie). Sí usa boto3 desde
#     2026-04-10 para subir los archivos de los usuarios a R2 (viene de
#     requirements.txt, no de acá).
#   * El código de mantenimiento corre aislado, sin acceso a la app ni a sus secretos.
#
# Contexto de build = backend/  (para que `COPY maintenance/` resuelva):
#   docker build -f backend/Dockerfile.cron backend -t box-crossfit-backup-cron:local
# ============================================================
FROM python:3.12-slim

# pg_dump de la MISMA major que el servidor de Neon (18.x).
# Debian 13 trae el cliente 17 y pg_dump ABORTA contra un servidor 18:
#   "pg_dump: error: aborting because of server version mismatch
#    detail: server version: 18.6; pg_dump version: 17.11"
# (es el bug que dejó el mecanismo de backups sin funcionar hasta el 26/09).
# Se instala el 18 desde el repo oficial PGDG y se VERIFICA en el build: si PGDG
# o la base cambian de major, el build falla en vez de fallar en silencio de noche.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && grep -q '^VERSION_CODENAME=trixie' /etc/os-release \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/* \
    && pg_dump --version \
    && pg_dump --version | grep -q " 18\." \
    && pip install --no-cache-dir boto3

# TZ=Chile para que los nombres de archivo salgan en hora local del box.
# DRY_RUN=1 por defecto: si alguien olvida la variable, la imagen NO sube nada.
ENV TZ=America/Santiago \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DRY_RUN=1

WORKDIR /app

# Solo los módulos de maintenance que necesitan los Cron Jobs (sin la app: acá no se
# importa FastAPI/SQLAlchemy). `__init__.py` es obligatorio para que resuelva
# `python -m maintenance.<script>`.
# ⚠️ Al agregar un Cron Job hay que agregar ACÁ su módulo y sus dependencias internas:
#    `watchdog_backups`, `restore_drill`, `mantenimiento_cloud` y `kpis_cloud` importan
#    `alertas`, y `alertas` importa `backup_cloud` (si falta uno, el job muere con "No
#    module named maintenance.<x>"). `mantenimiento_cloud` no necesita nada más: habla
#    con la base por `psql`, así que no arrastra SQLAlchemy ni la app (y por eso tampoco
#    hay pip nuevo). `kpis_cloud` tampoco: hace HTTP con `urllib` de la stdlib.
# EXCEPCIÓN (2026-09-27): `mantenimiento_cloud` importa `shared.estados` —el paquete neutral sin
# imports donde vive la lista de estados "cancelada" que también usa la app—, así que `shared/`
# va TAMBIÉN acá: si falta, el job muere con "No module named 'shared'". Son 2 archivos.
COPY maintenance/__init__.py ./maintenance/__init__.py
COPY maintenance/backup_cloud.py ./maintenance/backup_cloud.py
COPY maintenance/alertas.py ./maintenance/alertas.py
COPY maintenance/watchdog_backups.py ./maintenance/watchdog_backups.py
COPY maintenance/restore_drill.py ./maintenance/restore_drill.py
COPY maintenance/mantenimiento_cloud.py ./maintenance/mantenimiento_cloud.py
COPY maintenance/kpis_cloud.py ./maintenance/kpis_cloud.py
COPY shared/__init__.py ./shared/__init__.py
COPY shared/estados.py ./shared/estados.py

# Usuario no-root (OJO: en Debian ya existe un usuario de sistema `backup`
# con UID 34 ⇒ `useradd backup` falla con "username already in use").
RUN useradd --create-home --uid 1000 boxapp \
    && chown -R boxapp:boxapp /app
USER boxapp

# CMD por defecto = el backup (es el Cron Job que YA corre así en Render: no se cambia).
# Los otros jobs fijan su propio Command en el dashboard:
#   mantenimiento → python -m maintenance.mantenimiento_cloud
#   watchdog      → python -m maintenance.watchdog_backups
#   drill         → python -m maintenance.restore_drill
#   kpis y ML     → python -m maintenance.kpis_cloud      (Fase 8)
CMD ["python", "-m", "maintenance.backup_cloud"]
