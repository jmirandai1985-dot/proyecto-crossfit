# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.render — Imagen COMBINADA para hosting sin red privada
# (ej. free tier de Render): nginx sirve el build estático de React
# Y uvicorn corre el backend FastAPI DENTRO del MISMO contenedor.
# nginx proxya /api/ y /static/ a http://127.0.0.1:8000 (mismo contenedor,
# NO hay un servicio "backend" separado).
#
# NO altera backend/Dockerfile ni frontend/Dockerfile (esos siguen usándose
# para desarrollo local con docker-compose.yml).
# ============================================================

# ---- Stage 1: build del frontend (Vite) ----
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# VITE_API_URL vacío = mismo origen (el navegador llama a /api/ y nginx proxea).
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---- Stage 2: dependencias Python del backend (capa cacheable) ----
FROM python:3.12-slim AS deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ---- Stage 3: imagen final combinada (nginx + uvicorn) ----
FROM python:3.12-slim AS final
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata nginx \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && ln -snf /usr/share/zoneinfo/America/Santiago /etc/localtime \
    && echo "America/Santiago" > /etc/timezone

ENV TZ=America/Santiago \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Dependencias desde la stage deps (evita re-instalar en cada build).
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Código del backend (sin .env: las env vars se inyectan en runtime).
COPY backend/app/ app/
COPY backend/alembic/ alembic/
COPY backend/alembic.ini ./
COPY backend/requirements.txt ./

# Build del frontend → estáticos servidos por nginx.
COPY --from=frontend-build /app/dist /usr/share/nginx/html

# Config de nginx para esta imagen combinada (proxy a 127.0.0.1:8000).
COPY nginx.render.conf /etc/nginx/conf.d/default.conf
# Normaliza CRLF→LF (fuente creada en Windows). nginx tolera CRLF, pero se deja limpio.
RUN sed -i 's/\r$//' /etc/nginx/conf.d/default.conf

# Entrypoint que arranca nginx (background) + uvicorn (foreground).
COPY entrypoint.render.sh /entrypoint.render.sh
# Normaliza CRLF→LF: sin esto el shebang "#!/bin/sh\r" no es ejecutable →
# "exec: /entrypoint.render.sh: no such file or directory".
RUN chmod +x /entrypoint.render.sh \
    && sed -i 's/\r$//' /entrypoint.render.sh

# Directorios de datos en runtime (volúmenes en compose; no se bakean).
RUN mkdir -p /app/app/static/uploads /app/logs

# Usuario no-root para el backend.
RUN useradd --create-home --uid 1000 boxapp \
    && chown -R boxapp:boxapp /app

EXPOSE 80

# Healthcheck sobre uvicorn (mismo contenedor) — Render usa además su propio check.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=40s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)" || exit 1

CMD ["/entrypoint.render.sh"]
